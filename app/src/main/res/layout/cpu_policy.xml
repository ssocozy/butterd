<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Section" android:text="@string/ui_cpu_cluster" android:id="@+id/policy_title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Metric" android:text="@string/ui_pending_reading_17" android:layout_marginTop="8dp" android:textSize="24sp" android:id="@+id/policy_current" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Body" android:text="@string/ui_pending_reading_18" android:layout_marginTop="8dp" android:id="@+id/policy_range" />
    <com.google.android.material.button.MaterialButton android:id="@+id/policy_governor" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SecondaryButton" android:text="@string/cpu_select" android:layout_marginTop="16dp" app:icon="@drawable/ic_chevron" app:iconGravity="end" app:iconSize="18dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/policy_restore" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TextButton" android:text="@string/cpu_restore" android:layout_marginTop="8dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/policy_details_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/TextButton" android:text="@string/ui_supported_governors_clocks" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Body" android:text="@string/ui_empty" android:visibility="gone" android:layout_marginTop="8dp" android:id="@+id/policy_details" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:importantForAccessibility="no" android:layout_marginTop="20dp" />
</LinearLayout>