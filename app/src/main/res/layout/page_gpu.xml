<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_gpu" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="120dp">
        <TextView android:id="@+id/page_gpu_title" style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gpu_screen" />
        <TextView android:id="@+id/page_gpu_intro" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gpu_intro" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="20dp" android:background="@drawable/card" android:orientation="vertical">
            <TextView android:id="@+id/gpu_access_title" style="@style/RowValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/extra_readings_title" />
            <TextView android:id="@+id/gpu_access_note" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/detail_gpu_freq_label" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gpu_freq" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/detail_gpu_freq" style="@style/Metric" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/waiting" android:textSize="22sp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/gpu_note" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gpu_note" android:layout_marginTop="16dp" />
            <com.google.android.material.button.MaterialButton style="@style/SecondaryButton" android:id="@+id/gpu_access" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/access_options" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ROM GPU POLICY" style="@style/Section" android:layout_marginTop="32dp" android:layout_marginBottom="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DVFS timer margin (raw)" style="@style/Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" style="@style/RowValue" android:id="@+id/gpu_margin" android:layout_marginTop="6dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DVFS loading step (raw)" style="@style/Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" style="@style/RowValue" android:id="@+id/gpu_step" android:layout_marginTop="6dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The Power HAL changes these values for system workloads. A larger value is not a proven performance or efficiency improvement." style="@style/Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PERFORMANCE PROFILES" style="@style/Section" android:layout_marginTop="32dp" android:layout_marginBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose the ROM’s performance profile so CPU, GPU and thermal policy keep one owner. Butterd does not pin maximum GPU clocks." style="@style/Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/gpu_profiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Open ROM profiles" style="@style/NavigationRow" />
    </LinearLayout>
</ScrollView>