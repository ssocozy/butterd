<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_display" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="144dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Display" style="@style/Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh rate and touch, with your ROM in control." style="@style/Body" android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CURRENT DISPLAY RATE" style="@style/Section" android:layout_marginTop="32dp" android:layout_marginBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" style="@style/Metric" android:id="@+id/display_rate" android:textSize="52sp" android:fontFamily="sans-serif-light" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Android-reported refresh rate, sampled while Butterd is open. This is not game FPS or measured touch latency." style="@style/Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SUPPORTED MODES" style="@style/Section" android:layout_marginTop="32dp" android:layout_marginBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" style="@style/RowValue" android:id="@+id/display_modes" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TOUCH RESPONSE" style="@style/Section" android:layout_marginTop="32dp" android:layout_marginBottom="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="High touch sampling mode" style="@style/Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" style="@style/RowValue" android:id="@+id/touch_state" android:layout_marginTop="6dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="XiaomiParts manages manual and per-app modes. Auto mode follows the foreground app, so returning here from a game may disable it. The 0/1 flag does not measure touch Hz." style="@style/Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/display_parts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Touch settings in XiaomiParts" style="@style/NavigationRow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PER-APP REFRESH RATE" style="@style/Section" android:layout_marginTop="32dp" android:layout_marginBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use the ROM’s per-app controls when available. Butterd does not run a second foreground-app watcher or rewrite global refresh-rate limits." style="@style/Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/display_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Open display settings" style="@style/NavigationRow" />
    </LinearLayout>
</ScrollView>