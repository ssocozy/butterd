#!/system/bin/sh
MODDIR=${0%/bin/*}
umask 077
if [ "${1:-}" = play-store-spoof ]; then
  [ "$(id -u)" = 0 ] || exit 1
  case "${2:-}" in
    on) : > "$MODDIR/compatibility/vending.enabled" || exit 1; chmod 600 "$MODDIR/compatibility/vending.enabled" ;;
    off) rm -f "$MODDIR/compatibility/vending.enabled" || exit 1 ;;
    *) echo "Usage: play-store-spoof on|off"; exit 2 ;;
  esac
  . "$MODDIR/lib/compatibility.sh"
  restart_compatibility || { echo "Preference saved, but a Google process could not be restarted. Retry after closing Play Store."; exit 1; }
  echo "Play Store build spoofing updated. Google integrity and Play Store processes will reload it; no reboot needed."
  exit 0
fi
if [ "${1:-}" = pixel-spoof ]; then
  [ "$(id -u)" = 0 ] || exit 1
  case "${2:-}" in
    on) rm -f "$MODDIR/compatibility/spoof.disabled" || exit 1 ;;
    off) : > "$MODDIR/compatibility/spoof.disabled" || exit 1; chmod 600 "$MODDIR/compatibility/spoof.disabled" ;;
    *) echo "Usage: pixel-spoof on|off"; exit 2 ;;
  esac
  echo "Pixel spoof preference saved. Reboot required."
  exit 0
fi
exec "$MODDIR/bin/butter-engine" "$@"
